# Core
PRAJNA_ENV=development
PRAJNA_API_HOST=0.0.0.0
PRAJNA_API_PORT=8000
PRAJNA_CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Providers: demo | openai ; demo | brave
PRAJNA_MODEL_PROVIDER=demo
PRAJNA_SEARCH_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
BRAVE_SEARCH_API_KEY=

# Optional services
DATABASE_URL=postgresql+psycopg://prajna:prajna@localhost:5432/prajna
REDIS_URL=redis://localhost:6379/0

# Public clients
NEXT_PUBLIC_PRAJNA_API_URL=http://localhost:8000
EXPO_PUBLIC_PRAJNA_API_URL=http://localhost:8000
