{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PRAJNA",
  "version": "0.1.0",
  "identifier": "dev.prajwal.prajna",
  "build": {
    "frontendDist": "../../../apps/web/out",
    "beforeBuildCommand": "cd ../../.. && pnpm --filter @prajna/web build"
  },
  "app": {
    "windows": [{
      "title": "PRAJNA",
      "width": 1400,
      "height": 900,
      "minWidth": 900,
      "minHeight": 650,
      "center": true
    }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
